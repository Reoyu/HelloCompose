rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // TODO [T4.6] Aturan ini BOCOR: siapa pun yang login bisa membaca dan
    // MENIMPA foto profil orang lain, dengan ukuran dan tipe berkas apa pun.
    // Ganti dengan:
    //   - function isOwner(userId): request.auth != null && request.auth.uid == userId
    //   - read : hanya pemilik
    //   - write: pemilik && request.resource.size < 1 * 1024 * 1024
    //            && request.resource.contentType == 'image/jpeg'
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/profile.jpg {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
          && request.resource.size < 1 * 1024 * 1024
          && request.resource.contentType == 'image/jpeg';
    }
  }
}
