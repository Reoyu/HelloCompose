rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // TODO [T4.1] Rules ini BELUM AMAN. Setiap pengguna yang sudah login dapat
    // membaca dan menghapus catatan milik pengguna LAIN. Buat fungsi:
    //   function isOwner(userId) {
    //     return request.auth != null && request.auth.uid == userId;
    //   }
    // lalu pakai di allow. Ingat: autentikasi (sudah login) BUKAN otorisasi (pemilik data).
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // TODO [T4.2] (Tantangan) Validasi bentuk data saat create/update:
    //   function isValidNote() -> keenam field ada (keys().hasAll([...])),
    //   title string 1..200 karakter, content string, createdAt & updatedAt int,
    //   isPinned bool, tags list.
    //   allow read, delete    : if isOwner(userId);
    //   allow create, update  : if isOwner(userId) && isValidNote();
    function isValidNote() {
      let note = request.resource.data;
      return note.keys().hasAll(['title', 'content', 'createdAt', 'updatedAt', 'isPinned', 'tags'])
          && note.title is string && note.title.size() > 0 && note.title.size() <= 200
          && note.content is string
          && note.createdAt is int && note.updatedAt is int
          && note.isPinned is bool
          && note.tags is list;
    }

    match /users/{userId}/notes/{noteId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidNote();
    }
  }
}
